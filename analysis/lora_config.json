{
    "encoder_name": "sentence-transformers/all-mpnet-base-v2",
    "lora_config": {
        "r": 8,
        "lora_alpha": 32,
        "target_modules": ["query", "key", "value"],
        "lora_dropout": 0.1,
        "bias": "none",
        "task_type": null
    },
    "training_hyperparams": {
        "lr_encoder": 2e-5,
        "lr_head": 1e-4,
        "num_epochs": 20,
        "batch_size": 1,
        "gradient_accumulation_steps": 8,
        "max_grad_norm": 1.0,
        "weight_decay": 1e-4,
        "warmup_steps": 100
    },
    "data_config": {
        "max_turn_length": 128,
        "instance_dropout": 0.1
    }
}
